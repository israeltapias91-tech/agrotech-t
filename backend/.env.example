# AGROTECH backend — copiar a .env y completar. NUNCA commitear .env
DJANGO_SECRET_KEY=cambiar-por-valor-largo-aleatorio
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MariaDB 11.8 (MSI en puerto 3307: 3306 ocupado por MySQL80 local)
DB_NAME=agrotech_db
DB_USER=agrotech
DB_PASSWORD=agrotech-dev
DB_HOST=127.0.0.1
DB_PORT=3307

# Sesiones / CORS React futuro
# DEV local (HTTP): Secure=False. PROD HTTPS: Secure=True en ambas.
SESSION_COOKIE_AGE=86400
SESSION_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
CSRF_SAMESITE=Lax
CSRF_COOKIE_SECURE=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Negocio (pendientes NO inventados)
TRIAL_DAYS=14
GRACE_PERIOD_DAYS=

# Email + verificación (dev: consola/Mailpit; prod: SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AGROTECH <no-reply@agrotech.local>
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_SALT=agrotech-email-verify
EMAIL_VERIFICATION_TIMEOUT_SECONDS=86400

# Auth: primera capa anti fuerza bruta en login (DRF throttle, scope 'login')
LOGIN_THROTTLE_RATE=5/minute

# Password reset: expiración token nativo + throttle del request
PASSWORD_RESET_TIMEOUT_SECONDS=86400
PASSWORD_RESET_THROTTLE_RATE=5/minute

# Registro: throttle anti spam/cuentas masivas (scope 'registration')
REGISTRATION_THROTTLE_RATE=10/hour

# OTP login por correo: 6 dígitos / 10 min / 5 intentos / 3 reenvíos 15 min
OTP_LENGTH=6
OTP_TIMEOUT_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_LIMIT=3
OTP_RESEND_WINDOW_SECONDS=900
OTP_RESEND_MIN_INTERVAL=60
EMAIL_OTP_THROTTLE_RATE=10/minute

# Seguridad HTTP (FASE 4, progresiva — dev seguro por defecto)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
CSP_REPORT_ONLY=True

# Backoff progresivo (segunda capa tras throttling, nunca permanente)
BACKOFF_LOGIN_THRESHOLD=5
BACKOFF_LOGIN_WINDOW_SECONDS=900
BACKOFF_LOGIN_BASE_SECONDS=30
BACKOFF_LOGIN_MAX_SECONDS=300
BACKOFF_OTP_THRESHOLD=10
BACKOFF_OTP_WINDOW_SECONDS=900
BACKOFF_OTP_BASE_SECONDS=60
BACKOFF_OTP_MAX_SECONDS=600
