# AGROTECH backend — copiar a .env y completar. NUNCA commitear .env
DJANGO_SECRET_KEY=cambiar-por-valor-largo-aleatorio
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MariaDB 11.8 (MSI en puerto 3307: 3306 ocupado por MySQL80 local)
DB_NAME=agrotech_db
DB_USER=agrotech
DB_PASSWORD=agrotech-dev
DB_HOST=127.0.0.1
DB_PORT=3307

# Sesiones / CORS React futuro
SESSION_COOKIE_AGE=86400
SESSION_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Negocio (pendientes NO inventados)
TRIAL_DAYS=14
GRACE_PERIOD_DAYS=

# Email + verificación (dev: consola/Mailpit; prod: SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AGROTECH <no-reply@agrotech.local>
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_SALT=agrotech-email-verify
EMAIL_VERIFICATION_TIMEOUT_SECONDS=86400
